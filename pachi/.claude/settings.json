{
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh*)",
      "Bash(./scripts/verify.sh*)",
      "Bash(./scripts/capture.sh*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(godot-mono --headless*)",
      "mcp__trello__trelloReadBoard",
      "mcp__trello__trelloReadCard",
      "mcp__trello__trelloReadChecklist",
      "mcp__trello__trelloReadList",
      "mcp__trello__trelloReadMember",
      "mcp__trello__trelloSearch",
      "mcp__trello__trelloWriteCard",
      "mcp__trello__trelloWriteChecklist"
    ],
    "ask": [
      "Bash(git push*)",
      "mcp__trello__trelloWriteList",
      "mcp__trello__trelloWriteBoard"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(../pachi.0*/**)",
      "Edit(../pachi.0*/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.uid|*/.godot/*|*/addons/*) echo \"Blocked: $f is generated by Godot or third-party. Use the editor/--import instead.\" >&2; exit 2;; esac; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/doc-budget.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./scripts/check.sh --quiet 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
