[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://pachi-rust/target/debug/libpachi_rust.so"
linux.release.x86_64 =   "res://pachi-rust/target/release/libpachi_rust.so"
windows.debug.x86_64 =   "res://pachi-rust/target/debug/pachi_rust.dll"
windows.release.x86_64 = "res://pachi-rust/target/release/pachi_rust.dll"
macos.debug =            "res://pachi-rust/target/debug/libpachi_rust.dylib"
macos.release =          "res://pachi-rust/target/release/libpachi_rust.dylib"
macos.debug.arm64 =      "res://pachi-rust/target/debug/libpachi_rust.dylib"
macos.release.arm64 =    "res://pachi-rust/target/release/libpachi_rust.dylib"
